graph TD
    subgraph "External & Refresh"
        KAR[Karakeep API]
        REFRESH[Selective Refresh Jobs<br/>(cron + API refresh endpoint)]
        LOCK[Distributed Refresh Lock]
        KAR --> REFRESH
        REFRESH --> LOCK
    end

    subgraph "Source of Truth"
        DB[PostgreSQL bookmarks,<br/>tags, pages, and canonical slugs]
        REFRESH --> DB
    end

    subgraph "Consumers"
        CACHE[Next.js Cache Components<br/>("use cache", cacheTag)]
        UI_PAGES[Bookmark pages / tag pages / detail routes]
        RELCONTENT[Related Content & Search aggregators]
        BOOKMARKS_API[/api/bookmarks<br/>unstable_noStore() during handler work<br/>Cache-Control: public, s-maxage=60,<br/>stale-while-revalidate=300]
        REQUEST_TIME_APIS[/api/search/*,<br/>/api/related-content*<br/>connection() + Cache-Control: no-store]
        DB --> CACHE --> UI_PAGES
        CACHE --> RELCONTENT
        DB --> BOOKMARKS_API
        DB --> REQUEST_TIME_APIS
    end

    subgraph "Supporting Systems"
        OG_ENRICH[OpenGraph Enhancement + UnifiedImageService]
        HEALTH[/api/health/deep<br/>verifies slug + database integrity]
        OG_ENRICH --> REFRESH
        DB --> HEALTH
    end

    subgraph "Cache Tags & TTLs"
        TAGS[bookmarks, bookmark-${slug}, bookmarks-tag-${slug}, related-content]
        CACHE --> TAGS
    end

    style DB fill:#dff0d8,stroke:#2f6627,stroke-width:2px
    style CACHE fill:#e3f2fd,stroke:#1976d2,stroke-width:2px
    style BOOKMARKS_API fill:#fff3cd,stroke:#856404,stroke-width:2px
    style REQUEST_TIME_APIS fill:#fdecea,stroke:#b71c1c,stroke-width:2px
