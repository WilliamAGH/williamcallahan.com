graph TD
    subgraph "Build Time / Server-Side"
        A[data/blog/posts/*.mdx] -- "Canonical authoring source" --> B{types/schemas/blog-frontmatter.ts<br/>canonical frontmatter schema};
        B -- "Validates runtime MDX" --> V{lib/blog/validation.ts};
        B -- "Validates Node seed input" --> N[scripts/seed-blog-posts.node.mjs];
        V -- "Indexes frontmatter slugs" --> D{lib/blog/mdx.ts};
        D -- "Compiles validated MDX" --> C[getAllPosts()];
        C --> E[app/blog/page.tsx];
        E -- "Pre-renders List" --> F[blog-list.server.tsx];
        F -- "Renders Card" --> G[blog-card.tsx];
    end

    subgraph "Client-Side"
        H[User Request] --> I[Next.js serves prerendered page];
        I --> J{blog.client.tsx};
        J -- "Wraps content in" --> K{blog-window.client.tsx};
        K -- "Receives pre-rendered HTML" --> F;
    end

    style F fill:#ccf,stroke:#333,stroke-width:2px
    style J fill:#f9f,stroke:#333,stroke-width:2px
