{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cloudflare Cache Rules",
  "description": "Declarative config for Cloudflare Cache Rules (Rulesets API phase: http_request_cache_settings)",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "description": {
      "type": "string",
      "description": "Human-readable description of this ruleset"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "expression", "action", "action_parameters", "enabled"],
        "properties": {
          "description": {
            "type": "string",
            "description": "Human-readable rule name"
          },
          "expression": {
            "type": "string",
            "description": "Cloudflare Ruleset Engine expression (Wire format)"
          },
          "action": {
            "type": "string",
            "enum": ["set_cache_settings"],
            "description": "Must be set_cache_settings for cache rules"
          },
          "action_parameters": {
            "type": "object",
            "required": ["cache"],
            "properties": {
              "cache": { "type": "boolean" },
              "edge_ttl": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": ["respect_origin", "override_origin", "bypass_by_default"]
                  },
                  "default": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "TTL in seconds (required when mode is override_origin)"
                  },
                  "status_code_ttl": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["value"],
                      "properties": {
                        "status_code": { "type": "integer", "minimum": 100, "maximum": 999 },
                        "status_code_range": {
                          "type": "object",
                          "properties": {
                            "from": { "type": "integer", "minimum": 100, "maximum": 999 },
                            "to": { "type": "integer", "minimum": 100, "maximum": 999 }
                          },
                          "anyOf": [{ "required": ["from"] }, { "required": ["to"] }],
                          "allOf": [
                            {
                              "if": {
                                "type": "object",
                                "required": ["from", "to"]
                              },
                              "then": {
                                "type": "object",
                                "properties": {
                                  "to": {
                                    "type": "integer",
                                    "minimum": { "$data": "1/from" }
                                  }
                                }
                              }
                            }
                          ]
                        },
                        "value": {
                          "type": "integer",
                          "minimum": -1,
                          "description": "TTL in seconds; 0 revalidates and -1 prevents Cloudflare edge storage without modifying origin response headers"
                        }
                      },
                      "oneOf": [
                        { "required": ["status_code"] },
                        { "required": ["status_code_range"] }
                      ]
                    }
                  }
                },
                "required": ["mode"],
                "allOf": [
                  {
                    "if": {
                      "type": "object",
                      "properties": {
                        "mode": { "const": "override_origin" }
                      },
                      "required": ["mode"]
                    },
                    "then": {
                      "type": "object",
                      "required": ["default"]
                    }
                  }
                ]
              },
              "browser_ttl": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": ["respect_origin", "override_origin", "bypass_by_default"]
                  },
                  "default": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "TTL in seconds (required when mode is override_origin)"
                  }
                },
                "required": ["mode"],
                "allOf": [
                  {
                    "if": {
                      "type": "object",
                      "properties": {
                        "mode": { "const": "override_origin" }
                      },
                      "required": ["mode"]
                    },
                    "then": {
                      "type": "object",
                      "required": ["default"]
                    }
                  }
                ]
              }
            }
          },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
